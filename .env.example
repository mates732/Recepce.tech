# Vapi — get keys from https://dashboard.vapi.ai

# Private key (server-side only) — starts with "sk_"
VAPI_PRIVATE_KEY=

# Per-industry API keys (safe for frontend) — each starts with "pk_"
# Add a new block here for each new industry.
VAPI_BARBER_API_KEY=
VAPI_DENTIST_API_KEY=
VAPI_VETERINARY_API_KEY=
VAPI_RESTAURANT_API_KEY=
VAPI_HAIR_SALON_API_KEY=
VAPI_MASSAGE_API_KEY=
VAPI_FITNESS_API_KEY=

# Per-industry Assistant IDs
VAPI_BARBER_ASSISTANT_ID=
VAPI_DENTIST_ASSISTANT_ID=
VAPI_VETERINARY_ASSISTANT_ID=
VAPI_RESTAURANT_ASSISTANT_ID=
VAPI_HAIR_SALON_ASSISTANT_ID=
VAPI_MASSAGE_ASSISTANT_ID=
VAPI_FITNESS_ASSISTANT_ID=


# Telegram Bot API - Contact form notifications
# Get token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID to receive notifications (use @userinfobot to get your ID)
TELEGRAM_CHAT_ID=
