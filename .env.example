# Vapi credentials. Keep the private API key server-only.
VAPI_API_KEY=
VAPI_SERVER_SECRET=
PUBLIC_VAPI_PUBLIC_KEY=
# Optional per-assistant public key overrides (fall back to PUBLIC_VAPI_PUBLIC_KEY)
# PUBLIC_VAPI_PUBLIC_KEY_LUDMILA=
# PUBLIC_VAPI_PUBLIC_KEY_UGO_STROMOVKA=

# Vapi assistant IDs per client (server-only, mapped to slugs)
VAPI_ASSISTANT_ID_ATOMBIKE=
VAPI_ASSISTANT_ID_THERAPY_POINT=
VAPI_ASSISTANT_ID_NONAME_BARBERSHOP=
VAPI_ASSISTANT_ID_PAWS_AND_CARE=
VAPI_ASSISTANT_ID_LUDMILA=
VAPI_ASSISTANT_ID_UGO_STROMOVKA=

# Therapy Point chat API. Keep the API key server-only.
THERAPY_POINT_API_URL=
THERAPY_POINT_API_KEY=

# Admin authentication
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_OVERAGE_PRICE_ID=

# Database
DATABASE_URL=

# Application URL
NEXT_PUBLIC_APP_URL=

# Vapi webhook signing (for /api/webhooks/vapi)
# Vapi sends X-Vapi-Signature header with HMAC-SHA256 of the payload
# The secret is set in Vapi dashboard when configuring the webhook endpoint

# Stripe webhook signing (for /api/webhooks/stripe)
# Stripe sends Stripe-Signature header with HMAC-SHA256 of the payload
# The secret is set in Stripe dashboard when configuring the webhook endpoint